# URL base de la API de FinGrow-BE.
# En local, la API escucha en 5210 (perfil http de launchSettings) u 8080 si se levanta con docker compose.
NEXT_PUBLIC_API_URL=http://localhost:5210

# Número de WhatsApp de FinGrow al que el empleado manda su código de vinculación.
# Sender de WhatsApp aprobado en Twilio para FinGrow.
NEXT_PUBLIC_WHATSAPP_NUMBER=+5491172387537

# Usuario (sin @) del bot de Telegram con el que el empleado vincula su chat.
# Sin esta variable no aparece el botón "Mensaje Telegram" y el enlace de Configuración queda roto.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=fingrowapp_bot
