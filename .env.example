# URL base de la API de FinGrow-BE.
# En local, la API escucha en 5210 (perfil http de launchSettings) u 8080 si se levanta con docker compose.
NEXT_PUBLIC_API_URL=http://localhost:5210

# Número de WhatsApp de FinGrow al que el empleado manda su código de vinculación.
# El valor por defecto es el sandbox de Twilio; en producción va el número aprobado.
NEXT_PUBLIC_WHATSAPP_NUMBER=+14155238886
